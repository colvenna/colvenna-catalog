# An install's configuration: copy to deploy/config/<env>.env (git ignores it) and fill it in.
# One KEY=value per line; values are taken literally, never expanded. Every key is listed here; any
# other COLVENNA_ key is refused, so that a misspelt one cannot pass for a default.

# --- required ---------------------------------------------------------------------------------
# The environment's name: a lowercase letter, then lowercase letters and digits, 8 at most; not release
# or test, which are reserved.
COLVENNA_ENV=
# The AWS account to install into; the caller's credentials must be of it.
COLVENNA_ACCOUNT=
# A standard AWS region, e.g. us-west-2 (China and GovCloud are not supported).
COLVENNA_REGION=
# eks: Kubernetes pods in an EKS cluster; serverless: Lambda behind a private REST API (see the
# serverless section below). Each form refuses the other's keys set to anything but their defaults.
COLVENNA_FORM=eks
# With eks: the EKS cluster to install into.
COLVENNA_EKS_CLUSTER=

# --- names (colvenna-lake's, by default, so that it can switch to this catalog in place; EKS form) -
COLVENNA_NAMESPACE=colvenna-catalog
COLVENNA_RELEASE_NAME=colvenna-catalog
COLVENNA_SERVICE_ACCOUNT=colvenna-catalog
# The warehouse name clients pass, also the REST path prefix.
COLVENNA_WAREHOUSE_NAME=colvenna

# --- storage ------------------------------------------------------------------------------------
# An existing S3 bucket in COLVENNA_REGION, or empty to create one (kept when the catalog is uninstalled).
COLVENNA_BUCKET=
# The catalog's key prefix in the bucket: segments of [a-z0-9_-] joined by "/", no leading or trailing "/".
COLVENNA_WAREHOUSE_PREFIX=warehouse
# create: an RDS PostgreSQL 16 in the cluster's subnets (kept when the catalog is uninstalled);
# existing: the PostgreSQL below, whose admin user creates the catalog's own user and database (or, for a
# database restored from a snapshot, brings them in line: user manual, 6.2). An existing database is not
# publicly accessible and takes TLS connections only (rds.force_ssl=1); the serverless form signs in with
# RDS IAM tokens, so it needs IAM database authentication on too.
COLVENNA_DB=create
COLVENNA_DB_NAME=colvenna_catalog
COLVENNA_DB_USER=colvenna_catalog
# With COLVENNA_DB=existing: an RDS PostgreSQL instance's endpoint, or an Aurora PostgreSQL cluster's writer
# endpoint, in the install's VPC (the cluster's; serverless, COLVENNA_VPC_ID, or with COLVENNA_NETWORK=create
# the VPC the install made), whose security groups admit its port from the catalog (preflight checks
# both); its port; and a Secrets Manager secret (of COLVENNA_ACCOUNT and COLVENNA_REGION) holding
# {"username": ..., "password": ...} of a user that may create roles and databases. When the Storage stack
# made the database, also set COLVENNA_BUCKET (its BucketName, if it made the bucket): preflight refuses
# otherwise, as the stack would be deployed again without its database.
COLVENNA_DB_ENDPOINT=
COLVENNA_DB_PORT=5432
COLVENNA_DB_ADMIN_SECRET_ARN=

# --- per-table credentials ------------------------------------------------------------------------
# aws-sts: the catalog vends short-lived credentials for each table; disabled: engines use their own.
COLVENNA_DATA_TOKENS=aws-sts
# Between PT1H30M and PT12H.
COLVENNA_DATA_TOKEN_DURATION=PT3H

# --- placement and access (EKS form) -------------------------------------------------------------
# The nodes the catalog may run on, as k=v pairs separated by commas; empty for any node. A node with a
# workload's NoSchedule or NoExecute taint is not one (the catalog's pods tolerate none); a cordoned node,
# or one under a passing condition, is (docs/manual/install.md, Nodes).
COLVENNA_NODE_SELECTOR=
# on: an internal Network Load Balancer on the API port for clients in the VPC outside the cluster
# (needs the AWS Load Balancer Controller), admitting only COLVENNA_NLB_ALLOWED_CIDRS (comma-separated,
# each with a prefix longer than 0). They must hold no pod address: not the cluster's subnets, nor any
# node's (pods take their addresses from those), or every pod there would reach the API whatever its
# namespace's labels; give the subnets of the clients (EMR, say) instead.
COLVENNA_INTERNAL_NLB=off
COLVENNA_NLB_ALLOWED_CIDRS=
# Namespaces whose pods may call the API, and scrape the metrics port: the label (key=value) they carry.
COLVENNA_CLIENT_NAMESPACE_LABEL=colvenna-catalog/client=true
COLVENNA_METRICS_NAMESPACE_LABEL=colvenna-catalog/monitoring=true

# --- releases (install.sh --release <candidate>) ----------------------------------------------------
# The release registry that holds the candidate's image and chart: <account>.dkr.ecr.<region>.amazonaws.com
# (the candidate's manifest names repositories and digests, never a registry). Required with --release,
# unused from source. Its maintainer lists this account among its pull accounts; the installer's own
# identity needs ecr:GetAuthorizationToken, and ecr:BatchGetImage, ecr:GetDownloadUrlForLayer and
# ecr:BatchCheckLayerAvailability on the release's repositories.
COLVENNA_RELEASE_REGISTRY=

# --- the serverless form (COLVENNA_FORM=serverless) ---------------------------------------------------
# The catalog runs on Lambda in private subnets, reached only through a private REST API, that is
# through execute-api VPC endpoints, with a bearer token. The functions need S3 (a gateway endpoint),
# STS and Cognito identity (interface endpoints with private DNS) from their subnets.
# create: a new VPC (COLVENNA_VPC_CIDR, two private subnets, no internet gateway, no NAT) with those
# endpoints and an execute-api one, and a new database in it (COLVENNA_DB=create; later, existing for one
# restored into that VPC). Clients elsewhere reach the API through execute-api endpoints of their own
# VPCs, listed in COLVENNA_API_ENDPOINT_IDS.
# existing: your VPC and two or more of its private subnets (in two zones or more), whose endpoints
# (or NAT gateway) preflight checks and never changes; COLVENNA_API_ENDPOINT_IDS lists the execute-api
# endpoints clients use, one of them in COLVENNA_VPC_ID, and their security groups must admit HTTPS
# from the catalog's subnets.
COLVENNA_NETWORK=create
COLVENNA_VPC_CIDR=10.80.0.0/16
COLVENNA_VPC_ID=
COLVENNA_SUBNET_IDS=
COLVENNA_API_ENDPOINT_IDS=
# The server function's memory in MB (1024 to 10240), and how many requests it serves at once at most
# (1 to 1000): the connection budget, as each execution environment holds up to 5 connections.
COLVENNA_LAMBDA_MEMORY=2048
COLVENNA_LAMBDA_CONCURRENCY=10
# on: Lambda SnapStart on the server's published versions (restores in under a second instead of an
# init of 2 to 4 seconds). For a container image it is billed while the version is active, idle or not.
COLVENNA_SNAPSTART=off
