<?xml version="1.0" encoding="UTF-8"?>
<!-- The Flink adapter, compiled against Flink 1.20's Table API; the Flink 2.2 cell runs the same jar. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.colvenna.catalog.compat</groupId>
    <artifactId>compat-flows</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>flink</artifactId>

  <dependencies>
    <dependency>
      <groupId>com.colvenna.catalog.compat</groupId>
      <artifactId>core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.flink</groupId>
      <artifactId>flink-table-api-java</artifactId>
      <version>1.20.5</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.paimon</groupId>
      <artifactId>paimon-bundle</artifactId>
      <version>2.0.0</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>compat-flink</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
