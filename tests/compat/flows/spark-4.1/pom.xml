<?xml version="1.0" encoding="UTF-8"?>
<!-- The Spark adapter for Spark 4.1 (Scala 2.13, Java 17): spark-3.5's sources, compiled against
     Spark 4.1, whose Java API is not binary compatible with 3.5's. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.colvenna.catalog.compat</groupId>
    <artifactId>compat-flows</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>spark-4.1</artifactId>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.colvenna.catalog.compat</groupId>
      <artifactId>core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-sql_2.13</artifactId>
      <version>4.1.3</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>compat-spark-4.1</finalName>
    <sourceDirectory>../spark-3.5/src/main/java</sourceDirectory>
    <plugins>
      <!-- spark-3.5 formats the shared sources. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
