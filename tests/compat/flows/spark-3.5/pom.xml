<?xml version="1.0" encoding="UTF-8"?>
<!-- The Spark adapter for Spark 3.5 (Scala 2.12). Its sources are also the Spark 4.1 module's. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.colvenna.catalog.compat</groupId>
    <artifactId>compat-flows</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>spark-3.5</artifactId>

  <dependencies>
    <dependency>
      <groupId>com.colvenna.catalog.compat</groupId>
      <artifactId>core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-sql_2.12</artifactId>
      <version>3.5.9</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>compat-spark-3.5</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
